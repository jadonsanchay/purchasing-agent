# Copy to backend/.env and fill in. Never commit the real .env.

# LLM provider: openai (default) or scripted (no key needed; replays reference trajectories for demos)
LLM_PROVIDER=openai

# OpenAI (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# Agent behaviour
APPROVAL_THRESHOLD=5000        # PO value (currency units) above which a human must approve
MAX_DEVIATION_PCT=40           # deviation from system recommendation that triggers approval
MAX_RECOVERY_TURNS=2           # bounded retries when validation finds a mismatch
MAX_AGENT_TURNS=20             # hard cap on LLM tool-calling turns per run

# Storage
DB_PATH=./data/purchasing.db
